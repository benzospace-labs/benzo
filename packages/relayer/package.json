{
  "name": "@benzo/relayer",
  "version": "0.1.0",
  "description": "Self-hosted Benzo relayer: gasless submission of shielded transfers (liveness-only; never custody). Pays XLM fees, compensated in USDC out of the shielded pool.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "node init && tsc -p tsconfig.json",
    "serve": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@benzo/core": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "@stellar/stellar-sdk": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
